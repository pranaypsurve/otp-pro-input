{
  "name": "otp-pro-input",
  "version": "0.1.1",
  "description": "Headless, fully customizable OTP / segmented code input for React",
  "author": "Pranay Surve <pranaysurve75@gmail.com>",
  "license": "MIT",
  "homepage": "https://pranaypsurve.github.io/otp-pro-input",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:lib": "tsup --watch",
    "build": "tsup && node scripts/copy-css.mjs",
    "build:playground": "vite build",
    "deploy:pages": "npm run build:playground && npx --yes gh-pages -d playground-dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@eslint/js": "^9.20.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "vitest-axe": "^0.1.0",
    "vite": "^6.1.0"
  },
  "keywords": [
    "react",
    "otp",
    "one-time-password",
    "verification-code",
    "pin-input",
    "segmented-input",
    "headless",
    "accessible",
    "webotp"
  ]
}
